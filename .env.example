# ==============================================
# EAGLE AURA - ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env.local and fill in values
# ==============================================

# Supabase Database & Storage Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# App URL (For checkout return and download redirects)
PORT=3000
BASE_URL=http://localhost:3000

# Dodo Payments Configuration
# Set ENVIRONMENT to 'test_mode' for testing or 'live_mode' for production
DODO_PAYMENTS_API_KEY=your_dodo_payments_api_key
DODO_PAYMENTS_WEBHOOK_KEY=whsec_your_webhook_signing_secret
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_ID=

# Admin Dashboard Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password

# Email Delivery (Gmail SMTP)
# Generate App Password from: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_gmail_app_password
